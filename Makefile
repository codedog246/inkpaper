LATEXMK ?= latexmk
MAIN ?= main
LATEXMKFLAGS = -pdf -interaction=nonstopmode -halt-on-error
# Extra files to ship in the arXiv tarball, e.g. FIGURES = logo/*.pdf fig/*.pdf
FIGURES ?=
# Directories bundled for arXiv only if they exist (the example has none).
ARXIV_DIRS := $(wildcard logo figures)

.PHONY: all spec palette preview arxiv clean distclean

all:
	$(LATEXMK) $(LATEXMKFLAGS) $(MAIN).tex

# File rule used by the preview and arXiv targets; latexmk tracks the
# remaining dependencies (figures, .bbl) itself.
$(MAIN).pdf: $(MAIN).tex inkpaper.cls references.bib
	$(LATEXMK) $(LATEXMKFLAGS) $(MAIN).tex

# One-page callout specimen in each palette (visual regression page).
spec:
	for p in navy teal slate; do \
	  $(LATEXMK) $(LATEXMKFLAGS) -jobname=spec-$$p \
	    -usepretex='\PassOptionsToClass{palette='$$p'}{inkpaper}' spec.tex; \
	done

# Print the generated callout colour blocks and their contrast report.
palette:
	python3 semantic_palette.py
	python3 semantic_palette.py --tex

# First-page screenshot embedded in README.md (preview.png, 150 dpi);
# rebuilt whenever main.pdf is newer than the PNG.
preview: preview.png

preview.png: $(MAIN).pdf
	pdftoppm -f 1 -l 1 -r 150 -png -singlefile $(MAIN).pdf preview

# arXiv does not run BibTeX: ship the generated .bbl with the sources.
# COPYFILE_DISABLE stops macOS tar from adding ._* resource-fork entries.
arxiv: all
	COPYFILE_DISABLE=1 tar czf $(MAIN)-arxiv.tar.gz $(MAIN).tex inkpaper.cls references.bib $(MAIN).bbl $(FIGURES) $(ARXIV_DIRS)
	@echo "arXiv bundle written to $(MAIN)-arxiv.tar.gz"

clean:
	$(LATEXMK) -c $(MAIN).tex
	-$(LATEXMK) -c -jobname=spec-navy spec.tex
	-$(LATEXMK) -c -jobname=spec-teal spec.tex
	-$(LATEXMK) -c -jobname=spec-slate spec.tex
	rm -f $(MAIN).listing spec-*.listing

# Also removes main.pdf and the specimen PDFs; preview.png is kept (it is a
# committed asset, regenerated by `make preview`).
distclean:
	$(LATEXMK) -C $(MAIN).tex
	-$(LATEXMK) -C -jobname=spec-navy spec.tex
	-$(LATEXMK) -C -jobname=spec-teal spec.tex
	-$(LATEXMK) -C -jobname=spec-slate spec.tex
	rm -f $(MAIN).listing spec-*.listing $(MAIN)-arxiv.tar.gz
