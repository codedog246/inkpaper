  \textls[140]{\MakeUppercase{#1}}}}
\newcommand{\IP@boxlabel}{\sffamily\bfseries\footnotesize}
\newcommand{\IP@boxcaps}[1]{\textls[110]{\MakeUppercase{#1}}}

